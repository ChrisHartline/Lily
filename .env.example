# Clara/Lily Local Development Environment
# Copy this to .env and fill in your values

# PostgreSQL (Docker: clara-postgres-pgvector)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=claraLily
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# FalkorDB (Docker on port 6379)
FALKOR_HOST=localhost
FALKOR_PORT=6379
FALKOR_GRAPH=claralilymem
FALKOR_PASSWORD=

# Memory System
ENABLE_MEMORY=true
HDC_DIMENSIONS=10000

# HuggingFace (for model downloads)
HF_TOKEN=
